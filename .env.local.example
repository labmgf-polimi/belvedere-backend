# Local development against the compose.dev.yml database.
# Copy to .env.local; scripts/localdb.sh loads it via ENV_FILE instead of .env,
# so nothing here can point at production. Unset keys fall back to defaults.
DEBUG=True
SECRET_KEY="local-dev-only"

DB_HOST=127.0.0.1
DB_PORT=5442
DB_NAME=belvedere
DB_USER=belvedere
DB_PASSWORD=belvedere

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Emails (password reset) are printed to the runserver console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# S3 endpoint (not a secret; some image_index tests need it set).
S3_ENDPOINT_URL=https://nbg1.your-objectstorage.com
S3_REGION_NAME=nbg1
# Optional: read-only S3 keys for image previews.
# S3_READONLY_ACCESS_KEY=
# S3_READONLY_SECRET_KEY=
