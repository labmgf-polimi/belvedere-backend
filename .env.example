# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=dbpassword

# S3 storage configuration 
S3_ENDPOINT_URL=https://your-end-point-url.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name
S3_REGION_NAME=your-region-name

# Email (admin password reset). Omit EMAIL_BACKEND to print emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True          # STARTTLS on 587; for port 465 set EMAIL_USE_SSL=True and EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=Belvedere <noreply@example.com>
# PASSWORD_RESET_TIMEOUT=3600 # reset link lifetime in seconds

# django settings
DEBUG=False
SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8008

# For production
GUNICORN_CMD_ARGS=--workers 2 --threads 2 --timeout 60 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100   # Adjust the Gunicorn command arguments as needed for your deployment environment.